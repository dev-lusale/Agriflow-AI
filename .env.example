# ───────── AgriFlow AI Zambia — environment variables ─────────
# Copy to .env (local) and set the same keys in Vercel (production).
# Never prefix secrets with NEXT_PUBLIC_ — those are exposed to the browser.

# Database (PostgreSQL). On Supabase: DATABASE_URL = pooled (port 6543, ?pgbouncer=true),
# DIRECT_URL = direct connection (port 5432) used for migrations.
# Local default below matches `npm run db:local` (embedded Postgres on port 5544).
DATABASE_URL="postgresql://postgres:agriflow@localhost:5544/agriflow"
DIRECT_URL="postgresql://postgres:agriflow@localhost:5544/agriflow"

# Public base URL of the app (used in emails / links)
APP_URL="http://localhost:3000"

# Session signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# xAI Grok (server-side only). Without a key the app runs with clearly labelled built-in guidance.
XAI_API_KEY=""
XAI_MODEL="grok-4.7"
# Model used for crop images (must support image input)
XAI_VISION_MODEL="grok-4.7"
# Per-user AI requests per hour
AI_HOURLY_LIMIT="30"

# Weather — Open-Meteo is used by default and needs no key.
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""

# Supabase (optional). When set, uploads go to Supabase Storage; otherwise they are stored in Postgres.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="agriflow-uploads"

# Email (optional). With RESEND_API_KEY set, verification/reset emails are sent via Resend.
# Without it, emails are recorded in the outbox as NOT_CONFIGURED (never claimed as sent).
RESEND_API_KEY=""
EMAIL_FROM="AgriFlow AI <no-reply@example.com>"

# Show the DEMO MODE banner and demo-login shortcuts (set to "false" for a real launch)
DEMO_MODE="true"
# Password applied to all seeded demo accounts (choose your own; never use defaults in public deployments)
DEMO_PASSWORD="ChangeMe-Demo-2026"
